{
  "model": "claude-opus-5-5",
  "effortLevel": "high",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "20"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
