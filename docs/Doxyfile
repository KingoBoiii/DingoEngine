# The API reference: run `doxygen docs/Doxyfile` from the repository root. The HTML goes to
# build/docs/html and every warning to build/docs/warnings.txt, which CI requires to be empty.
# DE_DOCS_VERSION (the VERSION file in CI) names the release on each page.

PROJECT_NAME           = DingoEngine
PROJECT_NUMBER         = $(DE_DOCS_VERSION)
PROJECT_BRIEF          = "A C++20 game engine on Vulkan, DirectX 11 and DirectX 12"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO

INPUT                  = include/DingoEngine docs
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
# BuildInfo.h is generated by premake, so CI's checkout doesn't have it; versioning.md covers it.
EXCLUDE                = include/DingoEngine/BuildInfo.h
EXCLUDE_PATTERNS       = */docs/Doxyfile
USE_MDFILE_AS_MAINPAGE = docs/README.md
IMAGE_PATH             = docs

STRIP_FROM_PATH        = include docs
STRIP_FROM_INC_PATH    = include
FULL_PATH_NAMES        = YES

# Dingo::Internal is engine surface a public header has to name; docs/versioning.md leaves it
# out of the 1.x promise, so the reference leaves it out too.
EXCLUDE_SYMBOLS        = Dingo::Internal Dingo::Internal::* Internal

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
INTERNAL_DOCS          = NO
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = NO
DISTRIBUTE_GROUP_DOC   = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
TOC_INCLUDE_HEADINGS   = 5
MARKDOWN_ID_STYLE      = GITHUB

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = include
PREDEFINED             = DE_DOXYGEN \
                         "DE_SUPPRESS_DEPRECATED_BEGIN=" \
                         "DE_SUPPRESS_DEPRECATED_END=" \
                         "DE_EVENT_CLASS_TYPE(type)=" \
                         "DE_EVENT_CLASS_CATEGORY(category)="

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = build/docs/warnings.txt

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
HTML_COLORSTYLE        = AUTO_LIGHT
GENERATE_LATEX         = NO
HAVE_DOT               = NO
CLASS_GRAPH            = YES
